# Network Monitor Agent configuration
# Installed location: /etc/notes-network-monitor/agent.env (dir 700, file 600)
#
# Plain KEY=VALUE lines only. The agent parses this file; it never sources
# or executes it. Never commit a real API key.
NETWORK_MONITOR_API_KEY=
NETWORK_MONITOR_API_BASE_URL=https://notes.pidiman.sk/api/network
